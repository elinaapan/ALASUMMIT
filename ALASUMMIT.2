<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#123d31">
<title>ALASUMMIT — Alatau Peaks</title>
<style>
:root{--bg:#f4f1e8;--card:#fffdf8;--ink:#17211d;--muted:#66736d;--green:#123d31;--green2:#216b53;--line:#d8d5ca;--cream:#e9dfc8;--red:#8f3828;--shadow:0 16px 40px #17211d14;--r:22px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:linear-gradient(#edf1eb,#f7f3e9);color:var(--ink);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
button,input{font:inherit}button{cursor:pointer}.app{max-width:1180px;margin:auto;padding:16px}
header{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:8px 0 18px}.brand{display:flex;align-items:center;gap:11px;font-weight:900;letter-spacing:-.02em}.logo{width:43px;height:43px;border-radius:14px;background:var(--green);color:#fff;display:grid;place-items:center}.actions{display:flex;gap:7px;flex-wrap:wrap}
.btn,.chip{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:13px;padding:10px 13px;font-weight:800}.btn.primary{background:var(--green);color:white;border-color:var(--green)}.btn.soft{background:var(--cream);border-color:transparent}.btn:disabled{opacity:.45;cursor:not-allowed}
.hero{background:var(--green);color:white;border-radius:29px;padding:31px;display:grid;grid-template-columns:1.25fr .75fr;gap:22px;box-shadow:var(--shadow)}.eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:11px;font-weight:900;opacity:.72}h1{font-size:clamp(36px,5vw,58px);line-height:.97;letter-spacing:-.05em;margin:10px 0 15px}.hero p{color:#dce9e2;line-height:1.55;max-width:650px}.hero-art{display:grid;place-items:center;font-size:145px}
.searchrow{display:flex;gap:9px;margin-top:18px}.search{flex:1;border:0;border-radius:14px;padding:14px 15px;outline:0}.search:focus{box-shadow:0 0 0 4px #ffffff22}
main{padding:25px 0 50px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:12px;margin:8px 0 16px}h2{margin:0;font-size:27px;letter-spacing:-.03em}.muted{color:var(--muted)}.chips{display:flex;gap:7px;flex-wrap:wrap}.chip.active{background:var(--green);color:#fff;border-color:var(--green)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;box-shadow:0 7px 20px #17211d0d;transition:.18s}.card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.photo{height:185px;background:#c9d2cc;position:relative;overflow:hidden}.photo img{width:100%;height:100%;object-fit:cover;display:block}.photo .level{position:absolute;left:12px;top:12px;background:#ffffffdf;color:var(--green);padding:6px 8px;border-radius:9px;font-size:11px;font-weight:900}.fav{position:absolute;right:12px;top:12px;width:39px;height:39px;border:0;border-radius:50%;background:#ffffffdf;font-size:18px}
.body{padding:17px}.title{display:flex;justify-content:space-between;gap:8px}.title h3{margin:0;font-size:20px}.facts{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}.fact{background:#f1eee6;color:var(--muted);padding:6px 8px;border-radius:8px;font-size:12px}.body p{color:var(--muted);line-height:1.45;font-size:14px;min-height:40px}.cardbuttons{display:flex;gap:7px}.cardbuttons .btn:first-child{flex:1}
.empty{grid-column:1/-1;padding:42px;text-align:center;border:1px dashed var(--line);border-radius:var(--r)}.detail{display:none}.detail.active{display:block}.home.hidden{display:none}.back{margin-bottom:14px}
.detailhero{background:var(--green);color:#fff;border-radius:27px;overflow:hidden;display:grid;grid-template-columns:1fr .9fr}.detailhero .copy{padding:28px}.detailhero .copy p{color:#dce9e2;line-height:1.55}.detailphoto{min-height:300px}.detailphoto img{width:100%;height:100%;object-fit:cover}.tag{display:inline-block;background:#ffffff1c;border:1px solid #ffffff2b;border-radius:8px;padding:5px 8px;font-size:11px;font-weight:900}
.tabs{display:flex;gap:8px;overflow:auto;padding:13px 0;position:sticky;top:0;background:#f4f1e8ed;backdrop-filter:blur(9px);z-index:4}.tab{white-space:nowrap;border:1px solid var(--line);background:var(--card);border-radius:999px;padding:10px 14px;font-weight:800}.tab.active{background:var(--green);color:white;border-color:var(--green)}
.twocol{display:grid;grid-template-columns:1.2fr .8fr;gap:15px}.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:20px}.panel h3{margin:0 0 11px}.route{border:1px solid var(--line);border-radius:16px;padding:14px;margin:9px 0}.route h4{margin:0 0 7px}.route p{margin:0;color:var(--muted);line-height:1.5;font-size:14px}.list{margin:0;padding-left:20px;color:var(--muted);line-height:1.7}.notice{background:#edf3ef;border:1px solid #d1dfd7;color:#315044;border-radius:15px;padding:13px;line-height:1.5}.warning{background:#fff0e9;border:1px solid #f0c8ba;color:#733427;border-radius:15px;padding:13px;line-height:1.5}
.gpsbox{background:#101b17;color:#e8f3ed;border-radius:19px;padding:16px}.gpsgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}.gpsstat{background:#ffffff0c;border-radius:12px;padding:10px}.gpsstat small{display:block;color:#9db1a8}.gpsstat strong{display:block;margin-top:3px}.mapbox{height:340px;border:1px solid var(--line);border-radius:18px;background:repeating-linear-gradient(0deg,#f8f5ec,#f8f5ec 39px,#e9e4d7 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,#e9e4d7 40px);overflow:hidden;position:relative}.mapbox svg{width:100%;height:100%}.maphint{position:absolute;left:12px;top:12px;background:#fffdf8dd;border:1px solid var(--line);padding:8px 10px;border-radius:10px;font-size:12px;font-weight:800}
input[type=file]{display:none}.filelabel{display:inline-block}.small{font-size:12px;color:var(--muted)}footer{border-top:1px solid var(--line);padding:20px 0;color:var(--muted);font-size:12px;line-height:1.6}
.modal{display:none;position:fixed;inset:0;background:#0b141099;z-index:30;align-items:center;justify-content:center;padding:18px}.modal.open{display:flex}.modalbox{max-width:540px;width:100%;background:var(--card);border-radius:24px;padding:23px;max-height:88vh;overflow:auto}.modalhead{display:flex;justify-content:space-between}.close{border:0;background:transparent;font-size:25px}.langgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.lang{padding:18px;border:1px solid var(--line);border-radius:16px;background:white;font-weight:900}.lang:hover{background:var(--cream)}
.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,20px);background:var(--ink);color:white;padding:12px 15px;border-radius:12px;opacity:0;transition:.2s;z-index:50}.toast.show{opacity:1;transform:translate(-50%,0)}

/* Community, accounts and reviews */
.btn,.chip,.tab{transition:background .15s,border-color .15s,transform .15s}
.btn,.chip,.tab{background:#10243a;color:#f5f9ff;border-color:#69c7ff}
.btn:hover,.chip:hover,.tab:hover{background:#69c7ff;color:#06111d;border-color:#69c7ff;transform:translateY(-1px)}
.btn.primary{background:#69c7ff;border-color:#69c7ff;color:#06111d}
.btn.soft{background:#173653;color:#f5f9ff;border-color:#69c7ff}
.review-summary{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:10px 0 16px}
.stars{color:#69c7ff;font-size:22px;letter-spacing:1px}
.review{border:1px solid #294968;border-radius:15px;padding:13px;margin:9px 0;background:#0d1d30}
.review p{margin:7px 0;color:#c9d8ea;line-height:1.5}
.review small{color:#8fa9c4}
.review-form input,.review-form textarea,.profile-form input,.profile-form textarea,.profile-form select{width:100%;padding:11px;border-radius:12px;border:1px solid #315575;background:#f4f8ff;color:#07111f;margin:6px 0 10px;font:inherit}
.review-form textarea,.profile-form textarea{min-height:90px;resize:vertical}
.star-picker{display:flex;gap:4px;margin:4px 0 10px}.star-picker button{border:0;background:transparent;color:#6b87a3;font-size:26px;cursor:pointer}.star-picker button.active{color:#69c7ff}
.profile-card{display:flex;gap:14px;align-items:flex-start;padding:14px;border:1px solid #294968;border-radius:16px;margin:9px 0;background:#0d1d30}.avatar{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:#69c7ff;color:#06111d;font-weight:950;font-size:20px;flex:none}.profile-card h4{margin:0 0 4px}.profile-card p{margin:4px 0;color:#b9cbe0;line-height:1.4}.profile-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}
@media(max-width:850px){.grid{grid-template-columns:repeat(2,1fr)}.hero,.detailhero,.twocol{grid-template-columns:1fr}.hero-art{display:none}}
@media(max-width:560px){.app{padding:11px}.grid{grid-template-columns:1fr}.searchrow{flex-direction:column}.section-head{align-items:start;flex-direction:column}.gpsgrid{grid-template-columns:1fr 1fr}.detailhero .copy{padding:21px}.detailphoto{min-height:220px}.actions .btn span{display:none}}

/* ALASUMMIT black + blue theme */
:root{--bg:#070b13;--card:#101827;--ink:#edf4ff;--muted:#9fb1ca;--green:#07111f;--green2:#39a9ff;--line:#253a56;--cream:#132a45;--red:#ff657a;--shadow:0 18px 46px #0009;--r:22px}
body{background:radial-gradient(ellipse at 10% 0%,#102b4d 0%,#070b13 45%,#05080e 100%);color:var(--ink)}
.logo,.btn.primary{background:#35a8ff;border-color:#35a8ff;color:white}
.hero{background:linear-gradient(125deg,#07111f,#0d2b50 70%,#0757ad);border:1px solid #1f4b7c}
.btn,.chip{background:#101827;color:#eaf3ff;border-color:#29415f}
.btn.soft{background:#132a45;color:#d8eaff}
.chip.active,.tab.active{background:#42b5ff;color:#03101d;border-color:#35a8ff}
.card,.panel,.modalbox,.route,.gpsbox{background:#101827;border-color:#253a56;color:#edf4ff}
.card{box-shadow:0 12px 34px #0004}
.fact,.tag,.level{background:#104d7c;color:#d9ebff;border-color:#2b5c91}
.search{background:#f0f6ff;color:#0b1423}
.detailhero{background:linear-gradient(120deg,#0b1a2d,#113c6c);border:1px solid #28578a}
.notice{background:#0d3458;color:#e1f3ff;border-color:#3baeff}
.warning{background:#321b27;color:#ffdbe1;border-color:#753447}
footer{color:#9fb1ca}
.emergency-grid,.trail-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.info-card{background:#101827;border:1px solid #253a56;border-radius:18px;padding:16px}
.info-card h3{margin:0 0 8px}
.sos-number{font-size:28px;font-weight:950;color:#73c7ff;letter-spacing:-.03em}
.info-card p,.safety-copy{color:#bdcce0;line-height:1.55}
.section-panel{margin-top:24px;background:linear-gradient(140deg,#0d192a,#0c213b);border:1px solid #28476a;border-radius:24px;padding:22px}
.section-panel h2{margin-bottom:8px}
.checklist{padding-left:20px;line-height:1.7;color:#d2deef}
.offline-note{border:1px solid #2d6297;background:#0b2540;color:#cfe7ff;border-radius:14px;padding:13px;margin-top:12px;line-height:1.5}
@media(max-width:760px){.emergency-grid,.trail-grid{grid-template-columns:1fr}.section-panel{padding:16px}}
</style>
</head>
<body>
<div class="app">
<header>
  <div class="brand"><div class="logo">▲</div><span>ALASUMMIT</span></div>
  <div class="actions">
    <button class="btn" id="langBtn">🌐 <span>Language</span></button>
    <button class="btn" id="gpsTop">◎ <span>GPS</span></button>
    <button class="btn soft" id="favTop">♡ <span>Favorites</span></button>
    <button class="btn primary" id="accountTop">👤 <span>Account</span></button>
  </div>
</header>

<main>
<section id="home" class="home">
  <div class="hero">
    <div>
      <div class="eyebrow" data-i="eyebrow">Alatau hiking companion</div>
      <h1 data-i="heroTitle">Choose a peak.<br>Know the route.</h1>
      <p data-i="heroText">Explore the 15 peaks of the “My 15 Alatau Peaks” program, prepare your hike, and use GPS with a locally loaded trail even when you are offline.</p>
      <div class="searchrow"><input class="search" id="search" data-i-placeholder="search" placeholder="Search a peak…"><button class="btn primary" id="clear" data-i="reset">Reset</button></div>
    </div>
    <div class="hero-art">🏔️</div>
  </div>

  <div class="section-head">
    <div><h2 data-i="peaks">15 Alatau Peaks</h2><div class="muted" data-i="subtitle">Bronze · Silver · Gold</div></div>
    <div class="chips">
      <button class="chip active" data-filter="all" data-i="all">All</button>
      <button class="chip" data-filter="bronze" data-i="bronze">Bronze</button>
      <button class="chip" data-filter="silver" data-i="silver">Silver</button>
      <button class="chip" data-filter="gold" data-i="gold">Gold</button>
    </div>
  </div>
  <div class="grid" id="grid"></div>

  <section class="section-panel" aria-labelledby="trailTitle">
    <h2 id="trailTitle" data-i="extrasTitle">Trail planning &amp; preparation</h2>
    <p class="safety-copy" data-i="extrasIntro">Choose only a route appropriate to your experience. Trail access and conditions can change.</p>
    <div class="trail-grid">
      <article class="info-card"><h3 data-i="trailEasy">Day hikes</h3><p data-i="trailEasyText">Check official access, daylight, weather and your group’s fitness. Carry an offline track from a trusted source.</p></article>
      <article class="info-card"><h3 data-i="trailLong">Long ridge routes</h3><p data-i="trailLongText">Plan a conservative turnaround time, keep the group together and tell a trusted adult your plan and return time.</p></article>
      <article class="info-card"><h3 data-i="trailHard">High-altitude / technical peaks</h3><p data-i="trailHardText">Amangeldi and Talgar are serious objectives, not casual hikes. Use qualified mountain professionals and a verified current route plan; do not go alone.</p></article>
    </div>
    <div class="offline-note"><strong data-i="offlineTitle">What works offline?</strong><br><span data-i="offlineText">Peak descriptions, safety notes, favorites and a GPX track you import can be available locally. Photos still load from the web in this version; a full offline basemap and guaranteed offline GPS require locally bundled assets and compatible device/browser support.</span></div>
  </section>

  <section class="section-panel" aria-labelledby="sosTitle">
    <h2 id="sosTitle" data-i="emergencyTitle">Kazakhstan emergency numbers</h2>
    <p class="safety-copy" data-i="emergencyIntro">Save these before leaving. Call only for a real emergency.</p>
    <div class="emergency-grid">
      <a class="info-card" href="tel:112"><div class="sos-number">112</div><p data-i="emergency112">Unified emergency service / rescue</p></a>
      <a class="info-card" href="tel:101"><div class="sos-number">101</div><p data-i="emergency101">Fire and rescue</p></a>
      <a class="info-card" href="tel:102"><div class="sos-number">102</div><p data-i="emergency102">Police</p></a>
      <a class="info-card" href="tel:103"><div class="sos-number">103</div><p data-i="emergency103">Ambulance</p></a>
      <a class="info-card" href="tel:104"><div class="sos-number">104</div><p data-i="emergency104">Gas emergency</p></a>
    </div>
    <div class="offline-note"><strong data-i="adultTitle">Important safety note</strong><br><span data-i="adultText">Tell a parent/guardian and a trusted person your plan. For difficult or high-altitude objectives, go only with qualified adult mountain professionals. If anyone feels unwell, the group should stop and seek appropriate help.</span></div>
  </section>
</section>

<section class="section-panel" id="communityPanel" aria-labelledby="communityTitle">
  <div class="section-head"><div><h2 id="communityTitle">Mountain community</h2><div class="muted">Create a profile, share reviews, and find safe hiking partners.</div></div></div>
  <div class="trail-grid">
    <article class="info-card"><h3>👤 Your profile</h3><p>Create a simple hiking profile with your experience and favorite peaks. Your exact location and private contact details are never shown.</p><button class="btn primary" id="profileBtn">Create / edit profile</button></article>
    <article class="info-card"><h3>🥾 Find partners</h3><p>Browse local demo profiles by hiking level and interests. For safety, keep conversations in the app and involve a parent/guardian before meeting anyone.</p><button class="btn primary" id="partnersBtn">Find hiking partners</button></article>
    <article class="info-card"><h3>⭐ Mountain reviews</h3><p>Open any mountain to leave a star rating and review so other hikers can learn about your experience.</p><button class="btn primary" onclick="document.getElementById('grid').scrollIntoView({behavior:'smooth'})">Browse mountains</button></article>
  </div>
  <div class="offline-note"><strong>Safety first:</strong> Do not share your home address, live location, school, phone number, or other private information. Never meet an online contact alone. For difficult or high-altitude mountains, go with qualified adult mountain professionals.</div>
</section>

<section id="detail" class="detail">
  <button class="btn back" id="back" data-i="allPeaks">← All peaks</button>
  <div id="detailContent"></div>
</section>
</main>

<footer>
  <strong>ALASUMMIT</strong> — <span data-i="footer1">educational prototype.</span>
  <span data-i="footer2">Peak difficulty and heights are based on published descriptions of the “My 15 Alatau Peaks” program. Real trail conditions can change.</span>
  <br><span data-i="footer3">GPS can receive satellite coordinates without internet on some devices. A browser cannot guarantee GPS availability offline, and a full offline basemap requires locally bundled map data.</span>
</footer>
</div>

<div class="modal" id="modal"><div class="modalbox"><div class="modalhead"><h2 id="modalTitle">Language</h2><button class="close" id="close">×</button></div><div id="modalBody"></div></div></div>
<div class="toast" id="toast"></div>

<script>
"use strict";

/* 15 peaks: the published “My 15 Alatau Peaks” list.
   Source used for this prototype: MK Kazakhstan, 26 Jun 2024.
   Photos use real Wikimedia Commons photographs where available.
   For a production offline build, download/licence the photos and bundle them locally. */

const peaks=[
{id:"chimbulachka",name:"Chimbulachka",kk:"Шымбұлақ шыңы",ru:"Чимбулачка",en:"Chimbulachka",height:"≈3,450 m",level:"bronze",photo:"https://commons.wikimedia.org/wiki/Special:Redirect/file/Chimbulachka%20Peak.jpg?width=1000",credit:"Wikimedia Commons",desc:"A high ridge peak associated with the Shymbulak area.",kkd:"Шымбұлақ аймағымен байланысты биік жота шыңы.",rud:"Высокая вершина в районе Шымбулака."},
{id:"big-almaty",name:"Big Almaty Peak",kk:"Үлкен Алматы шыңы",ru:"Большой Алматинский пик",en:"Big Almaty Peak",height:"≈3,680 m",level:"bronze",photo:"https://commons.wikimedia.org/wiki/Special:Redirect/file/Big%20Almaty%20peak.jpg?width=1000",credit:"Wikimedia Commons",desc:"A major high point near the Big Almaty Lake area.",kkd:"Үлкен Алматы көлі аймағындағы биік шың.",rud:"Высокая вершина в районе Большого Алматинского озера."},
{id:"kumbel",name:"Kumbel",kk:"Күмбел",ru:"Кумбель",en:"Kumbel",height:"≈3,200 m",level:"bronze",photo:"https://commons.wikimedia.org/wiki/Special:Redirect/file/Kumbel%20Peak%20-plate.jpg?width=1000",credit:"Wikimedia Commons",desc:"A popular ridge peak reached from the Kok-Zhailau side.",kkd:"Көкжайлау жағынан жетуге болатын танымал жота шыңы.",rud:"Популярная вершина на хребте со стороны Кок-Жайляу."},
{id:"bukreev",name:"Bukreev Peak",kk:"Букреев шыңы",ru:"Пик Букреева",en:"Bukreev Peak",height:"≈3,010 m",level:"bronze",photo:"https://commons.wikimedia.org/wiki/Special:Redirect/file/Boukreev%201.jpg?width=1000",credit:"Wikimedia Commons",desc:"A well-known peak named after mountaineer Anatoly Bukreev.",kkd:"Альпинист Анатолий Букреевтің атымен аталған белгілі шың.",rud:"Известная вершина, названная в честь альпиниста Анатолия Букреева."},
{id:"furmanov",name:"Furmanov Peak",kk:"Фурманов шыңы",ru:"Пик Фурманова",en:"Furmanov Peak",height:"≈3,053 m",level:"bronze",photo:"https://commons.wikimedia.org/wiki/Special:Redirect/file/Furmanov%20peak%20with%20view%20on%20Talgar%20peak.jpg?width=1000",credit:"Wikimedia Commons",desc:"One of the most popular hiking peaks near Medeu.",kkd:"Медеу маңындағы ең танымал жаяу бағыттардың бірі.",rud:"Одна из самых популярных вершин для походов возле Медеу."},
{id:"titov",name:"Titov Peak",kk:"Титов шыңы",ru:"Пик Титова",en:"Titov Peak",height:"≈3,871 m",level:"silver",photo:"https://commons.wikimedia.org/wiki/Special:Redirect/file/View%20of%20Titov%20lakes%20from%20Peak%20Titov.jpg?width=1000",credit:"Wikimedia Commons",desc:"A higher peak requiring more preparation than the bronze group.",kkd:"Қола деңгейіне қарағанда көбірек дайындықты қажет ететін биік шың.",rud:"Более высокая вершина, требующая большей подготовки."},
