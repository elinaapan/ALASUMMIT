let lang=localStorage.getItem("alasummitLang")||null, filter="all", query="", fav=[];
try{fav=JSON.parse(localStorage.getItem("alasummitFav")||"[]")}catch(e){fav=[]}
let watchId=null, lastPos=null, track=[];

function T(k){return (tr[lang]||tr.en)[k]||tr.en[k]||k}
function nameOf(p){return lang==="kk"?p.kk:lang==="ru"?p.ru:p.en}
function saveFav(){try{localStorage.setItem("alasummitFav",JSON.stringify(fav))}catch(e){}}
function esc(s){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function toast(s){let x=document.getElementById("toast");x.textContent=s;x.classList.add("show");clearTimeout(window.tt);window.tt=setTimeout(()=>x.classList.remove("show"),2400)}
function openModal(title,body){document.getElementById("modalTitle").textContent=title;document.getElementById("modalBody").innerHTML=body;document.getElementById("modal").classList.add("open")}
function applyLang(){
  document.documentElement.lang=lang;
  document.querySelectorAll("[data-i]").forEach(x=>x.innerHTML=T(x.dataset.i));
  document.querySelectorAll("[data-i-placeholder]").forEach(x=>x.placeholder=T(x.dataset.iPlaceholder));
  document.getElementById("langBtn").innerHTML=`🌐 <span>${lang==="kk"?"Қазақша":lang==="ru"?"Русский":"English"}</span>`;
  render();
}
function chooseLang(){
  openModal(T("choose"),`<div class="langgrid"><button class="lang" onclick="setLang('ru')">🇷🇺 Русский</button><button class="lang" onclick="setLang('kk')">🇰🇿 Қазақша</button><button class="lang" onclick="setLang('en')">🇬🇧 English</button></div>`);
}
function setLang(x){lang=x;try{localStorage.setItem("alasummitLang",x)}catch(e){}document.getElementById("modal").classList.remove("open");applyLang()}
function filtered(){
 return peaks.filter(p=>{
  let q=query.trim().toLowerCase(), n=[p.name,p.kk,p.ru,p.en].join(" ").toLowerCase();
  return (filter==="all"||p.level===filter)&&(!q||n.includes(q))&&(!window.onlyFav||fav.includes(p.id))
 })
}

const FALLBACK_MOUNTAIN="data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%271200%27 height=%27600%27 viewBox=%270 0 1200 600%27%3E%3Crect width=%271200%27 height=%27600%27 fill=%27%230b1b2d%27/%3E%3Cpath d=%27M0 520L280 250 470 430 650 180 900 430 1080 280 1200 430V600H0Z%27 fill=%27%231c5a8a%27/%3E%3Cpath d=%27M650 180L580 290 650 255 720 310Z%27 fill=%27%23dff3ff%27/%3E%3Ctext x=%27600%27 y=%27550%27 text-anchor=%27middle%27 fill=%27%23fff%27 font-family=%27Arial%27 font-size=%2730%27%3EVerified photo unavailable%3C/text%3E%3C/svg%3E";
let reviews={}; let account=null; let profiles=[]; let messages=[];
try{reviews=JSON.parse(localStorage.getItem("alasummitReviews")||"{}")}catch(e){reviews={}}
try{account=JSON.parse(localStorage.getItem("alasummitAccount")||"null")}catch(e){account=null}
try{profiles=JSON.parse(localStorage.getItem("alasummitProfiles")||"[]")}catch(e){profiles=[]}
try{messages=JSON.parse(localStorage.getItem("alasummitMessages")||"[]")}catch(e){messages=[]}
function saveCommunity(){try{localStorage.setItem("alasummitReviews",JSON.stringify(reviews));localStorage.setItem("alasummitAccount",JSON.stringify(account));localStorage.setItem("alasummitProfiles",JSON.stringify(profiles));localStorage.setItem("alasummitMessages",JSON.stringify(messages))}catch(e){}}
function reviewCount(id){return (reviews[id]||[]).length}
function reviewAvg(id){const a=reviews[id]||[];return a.length?(a.reduce((s,x)=>s+x.rating,0)/a.length).toFixed(1):"—"}
function stars(n){return "★".repeat(n)+"☆".repeat(5-n)}
function reviewsHTML(p){
 const arr=reviews[p.id]||[];
 return `<h3>⭐ Reviews for ${esc(nameOf(p))}</h3><div class="review-summary"><span class="stars">${arr.length?stars(Math.round(Number(reviewAvg(p.id)))):"☆☆☆☆☆"}</span><strong>${reviewAvg(p.id)}</strong><span class="muted">${arr.length} review${arr.length===1?"":"s"}</span></div>
 <div class="review-form"><label><strong>Your rating</strong></label><div class="star-picker" id="starPicker">${[1,2,3,4,5].map(n=>`<button type="button" data-star="${n}" onclick="pickStar(${n},'${p.id}')">★</button>`).join("")}</div><textarea id="reviewText" placeholder="Write about the route, views, conditions, or preparation..."></textarea><button class="btn primary" onclick="submitReview('${p.id}')">Post review</button></div>
 <div style="margin-top:16px">${arr.length?arr.slice().reverse().map(r=>`<div class="review"><strong>${esc(r.name)}</strong> <span class="stars">${stars(r.rating)}</span><small> · ${esc(r.date)}</small><p>${esc(r.text)}</p></div>`).join(""):"<div class='notice'>No reviews yet. Be the first to share your experience.</div>"}</div>`;
}
let selectedRating=5;
function pickStar(n,id){selectedRating=n;document.querySelectorAll("#starPicker button").forEach(b=>b.classList.toggle("active",Number(b.dataset.star)<=n))}
function submitReview(id){
 const text=(document.getElementById("reviewText")?.value||"").trim(); if(!text){toast("Write a review first.");return}
 const name=account?.name||"Anonymous hiker"; (reviews[id] ||= []).push({name,rating:selectedRating,text,date:new Date().toLocaleDateString()});saveCommunity();openPeak(id);setTimeout(()=>document.querySelector('[data-tab="reviews"]')?.click(),80);toast("Review posted!")
}
function openPeakReviews(id){openPeak(id);setTimeout(()=>document.querySelector('[data-tab="reviews"]')?.click(),80)}
function profileModal(){
 const a=account||{name:"",level:"Beginner",bio:"",interests:""};
 openModal("Your profile",`<div class="profile-form"><label>Name</label><input id="pfName" value="${esc(a.name)}" maxlength="30" placeholder="First name or nickname"><label>Hiking experience</label><select id="pfLevel"><option ${a.level==="Beginner"?"selected":""}>Beginner</option><option ${a.level==="Intermediate"?"selected":""}>Intermediate</option><option ${a.level==="Advanced"?"selected":""}>Advanced</option></select><label>About you</label><textarea id="pfBio" maxlength="180" placeholder="Example: I like day hikes and scenic routes.">${esc(a.bio)}</textarea><label>Favorite mountains / interests</label><input id="pfInterests" maxlength="120" value="${esc(a.interests)}" placeholder="Kumbel, Furmanov, photography..."><button class="btn primary" onclick="saveProfile()">Save profile</button>${account?` <button class="btn" onclick="logout()">Log out</button>`:""}</div><div class="offline-note">For this single-file version, profiles are stored only in this browser. Do not enter private contact information.</div>`)
}
function saveProfile(){const name=document.getElementById("pfName").value.trim();if(!name){toast("Please add a name or nickname.");return}account={name,level:document.getElementById("pfLevel").value,bio:document.getElementById("pfBio").value.trim(),interests:document.getElementById("pfInterests").value.trim()};const i=profiles.findIndex(x=>x.name===name);if(i>=0)profiles[i]=account;else profiles.push(account);saveCommunity();document.getElementById("modal").classList.remove("open");toast("Profile saved!")}
function logout(){account=null;saveCommunity();document.getElementById("modal").classList.remove("open");toast("Logged out")}
function partnersModal(){
 const list=profiles.filter(x=>!account||x.name!==account.name);
 openModal("Find hiking partners",`${account?`<div class="notice">Hi ${esc(account.name)}! Keep conversations in the app and involve a parent/guardian before meeting an online contact.</div>`:`<div class="notice">Create a profile first if you want your own profile to appear here.</div>`}<div style="margin-top:12px">${list.length?list.map((x,i)=>`<div class="profile-card"><div class="avatar">${esc(x.name.charAt(0).toUpperCase())}</div><div><h4>${esc(x.name)} <span class="tag">${esc(x.level)}</span></h4><p>${esc(x.bio||"No bio yet.")}</p><p><strong>Interests:</strong> ${esc(x.interests||"Not listed")}</p><div class="profile-actions">${account?`<button class="btn primary" onclick="messageProfile(${i})">Message</button>`:""}</div></div></div>`).join(""):`<div class="empty"><h3>No profiles on this device yet</h3><p class="muted">Create profiles on this browser to test the partner feature. A real multi-device community needs a backend.</p></div>`}</div>`)
}
function messageProfile(i){const target=profiles.filter(x=>!account||x.name!==account.name)[i];if(!target)return;openModal("Message "+esc(target.name),`<textarea id="msgText" placeholder="Write a safe, friendly message..."></textarea><button class="btn primary" onclick="sendMessage('${esc(target.name)}')">Send</button><div class="offline-note">Do not share your address, phone number, school, live location, or other private information.</div>`)}
function sendMessage(to){const text=(document.getElementById("msgText")?.value||"").trim();if(!text){toast("Write a message first.");return}messages.push({from:account?.name||"Anonymous",to,text,date:new Date().toLocaleString()});saveCommunity();document.getElementById("modal").classList.remove("open");toast("Message saved")}

function render(){
 peaks.forEach(p=>{if(!p.photo)p.photo=FALLBACK_MOUNTAIN;});
 const g=document.getElementById("grid"),list=filtered();
 if(!list.length){g.innerHTML=`<div class="empty"><div style="font-size:38px">🔎</div><h3>${T("noFav")}</h3><p class="muted">${T("notVerified")}</p><button class="btn primary" onclick="resetAll()">${T("all")}</button></div>`;return}
 g.innerHTML=list.map(p=>`
 <article class="card">
  <div class="photo"><img loading="lazy" src="${p.photo || FALLBACK_MOUNTAIN}" alt="${esc(nameOf(p))}" onerror="this.onerror=null;this.src=FALLBACK_MOUNTAIN"><span class="level">${T(p.level)}</span><button class="fav" onclick="toggleFav('${p.id}')">${fav.includes(p.id)?"♥":"♡"}</button></div>
  <div class="body"><div class="title"><h3>${esc(nameOf(p))}</h3></div><div class="facts"><span class="fact">${p.height}</span><span class="fact">${T(p.level)}</span></div><p>${esc(lang==="kk"?p.kkd:lang==="ru"?p.rud:p.desc)}</p><div class="cardbuttons"><button class="btn primary" onclick="openPeak('${p.id}')">${T("routes")}</button><button class="btn" onclick="openPeakReviews('${p.id}')">⭐ ${reviewCount(p.id)}</button><button class="btn" onclick="toggleFav('${p.id}')">${fav.includes(p.id)?"♥":"♡"}</button></div></div>
 </article>`).join("");
}
function toggleFav(id){fav=fav.includes(id)?fav.filter(x=>x!==id):[...fav,id];saveFav();render();toast(fav.includes(id)?"♥":"♡")}
function resetAll(){filter="all";query="";window.onlyFav=false;document.getElementById("search").value="";document.querySelectorAll(".chip").forEach(x=>x.classList.toggle("active",x.dataset.filter==="all"));render()}
function openPeak(id){
 const p=peaks.find(x=>x.id===id);if(!p)return;
 document.getElementById("home").classList.add("hidden");document.getElementById("detail").classList.add("active");
 document.getElementById("detailContent").innerHTML=`
 <div class="detailhero"><div class="copy"><span class="tag">${T("demo")}</span><div class="eyebrow" style="margin-top:13px">${T(p.level)} · ${p.height}</div><h1>${esc(nameOf(p))}</h1><p>${esc(lang==="kk"?p.kkd:lang==="ru"?p.rud:p.desc)}</p><button class="btn" onclick="toggleFav('${p.id}')">${fav.includes(p.id)?"♥":"♡"} ${fav.includes(p.id)?T("gold"):T("bronze")}</button></div><div class="detailphoto"><img src="${p.photo || FALLBACK_MOUNTAIN}" alt="${esc(nameOf(p))}" onerror="this.onerror=null;this.src=FALLBACK_MOUNTAIN"></div></div>
 <div class="tabs"><button class="tab active" data-tab="route">${T("routes")}</button><button class="tab" data-tab="gear">${T("gear")}</button><button class="tab" data-tab="safety">${T("safety")}</button><button class="tab" data-tab="start">${T("start")}</button><button class="tab" data-tab="gps">${T("gps")}</button><button class="tab" data-tab="reviews">⭐ Reviews</button></div>
 <div class="twocol"><div class="panel" id="tab"></div><aside class="panel"><div class="notice">${esc(T("demo2"))}</div><div style="height:9px"></div><div class="warning">${esc(T("notVerified"))}</div></aside></div>`;
 document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));b.classList.add("active");showTab(b.dataset.tab,p)});
 showTab("route",p);window.scrollTo({top:0,behavior:"smooth"});
}
function showTab(tab,p){
 const b=document.getElementById("tab");if(!b)return;
 if(tab==="route")b.innerHTML=`<h3>${T("routes")}</h3><div class="route"><h4>${esc(nameOf(p))}</h4><p>${esc(T("notVerified"))}</p></div><div class="route"><h4>${T("offline")}</h4><p>${esc(T("noTrack"))}</p><label class="btn soft filelabel">📂 ${T("load")}<input id="gpx" type="file" accept=".gpx,application/gpx+xml"></label></div><div id="routeMap"></div>`;
 if(tab==="gear")b.innerHTML=`<h3>${T("gear")}</h3><p class="muted">${T("gearIntro")}</p><ul class="list">${(lang==="kk"?["жеткілікті су және қауіпсіз тағам","жақсы тозбайтын треккинг аяқ киімі және қосымша шұлық","жылы қабатты киім, бас киім және қолғап","су өткізбейтін/желден қорғайтын сыртқы қабат","күннен қорғайтын көзілдірік, SPF кремі және ерінге арналған бальзам","толық зарядталған телефон, қуат банкі және офлайн GPX картасы","бас шам және қосалқы батарея","алғашқы көмек қобдишасы және жеке дәрілер","ысқырық, төтенше көрінетін киім және құжаттар","қоқысқа арналған пакет және ауа райына сай қосымша киім"]:lang==="ru"?["достаточно воды и безопасная еда","надёжная треккинговая обувь и запасные носки","тёплые слои одежды, шапка и перчатки","водо- и ветрозащитная верхняя одежда","солнцезащитные очки, крем SPF и бальзам для губ","полностью заряженный телефон, power bank и офлайн GPX-трек","налобный фонарь и запасные батарейки","аптечка и личные лекарства","свисток, заметная аварийная одежда и документы","пакет для мусора и дополнительный слой одежды по погоде"]:["enough water and safe food","reliable hiking boots/shoes and spare socks","warm clothing layers, hat and gloves","waterproof/windproof outer layer","sunglasses, sunscreen and lip balm","fully charged phone, power bank and offline GPX track","headlamp and spare batteries","first-aid kit and personal medication","whistle, high-visibility emergency layer and ID","waste bag and an extra weather-appropriate layer"]).map(x=>`<li>${x}</li>`).join("")}</ul><div class="warning">${T("adultText")}</div>`;
 if(tab==="safety")b.innerHTML=`<h3>${T("safety")}</h3><div class="warning">${lang==="kk"?"Биіктік, суық, жел және ауа райы тез өзгеруі мүмкін. Жалғыз барма, ата-анаңа/қамқоршыңа жоспарыңды айт. Бас ауыруы, жүрек айну, шатасу, әлсіздік немесе тыныс алудың қиындауы болса, жоғары көтерілуді жалғастырмай, қауіпсіз көмек ізде.":lang==="ru"?"Высота, холод, ветер и погода могут быстро меняться. Не ходи один; сообщи родителю/опекуну свой план. При головной боли, тошноте, спутанности, сильной слабости или затруднённом дыхании не продолжай подъём и ищи безопасную помощь.":"Altitude, cold, wind and weather can change quickly. Do not go alone; tell a parent/guardian your plan. If headache, nausea, confusion, unusual weakness or difficulty breathing occurs, do not continue ascending; seek appropriate help."}</div><div class="offline-note">${T("adultText")}</div>`;
 if(tab==="start")b.innerHTML=`<h3>${T("start")}</h3><div class="route"><h4>${lang==="kk"?"Ерте бастауға жоспарла":"Планируй запас времени"}</h4><p>${lang==="ru"?"Для длительного похода оставляй запас времени на спуск до темноты. Точное время старта зависит от сезона, маршрута и погоды.":lang==="kk"?"Ұзақ жорықта қараңғыға дейін түсуге уақыт қалдыр. Нақты басталу уақыты маусымға, маршрутқа және ауа райына байланысты.":"For a long hike, leave enough time to descend before dark. Exact start time depends on season, route and weather."}</p></div>`;
 if(tab==="gps")b.innerHTML=gpsHTML();
  if(tab==="reviews")b.innerHTML=reviewsHTML(p);
 if(tab==="route"){setTimeout(()=>{const f=document.getElementById("gpx");if(f)f.onchange=e=>loadGPX(e.target.files[0])},0);drawTrack()}
}
function gpsHTML(){
 return `<div class="gpsbox"><h3>${T("gps")}</h3><p>${T("footer3")}</p><div class="gpsgrid"><div class="gpsstat"><small>${T("lat")}</small><strong id="lat">—</strong></div><div class="gpsstat"><small>${T("lon")}</small><strong id="lon">—</strong></div><div class="gpsstat"><small>${T("accuracy")}</small><strong id="acc">—</strong></div><div class="gpsstat"><small>${T("alt")}</small><strong id="alt">—</strong></div><div class="gpsstat"><small>${T("status")}</small><strong id="gpsstatus">${T("waiting")}</strong></div></div><button class="btn primary" id="gpsStart">${watchId===null?T("startGPS"):T("stopGPS")}</button></div><div style="height:12px"></div><div class="mapbox" id="gpsMap"><div class="maphint">${T("offline")}</div><svg viewBox="0 0 800 500"><path id="trackPath" d="" fill="none" stroke="#216b53" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><circle id="userDot" cx="-20" cy="-20" r="9" fill="#8f3828"/></svg></div>`;
}
function startGPS(){
 if(!navigator.geolocation){setGPSStatus(T("unsupported"));return}
 if(watchId!==null){navigator.geolocation.clearWatch(watchId);watchId=null;setGPSStatus(T("waiting"));return}
 setGPSStatus(T("waiting"));
 watchId=navigator.geolocation.watchPosition(pos=>{
  lastPos=pos.coords;setText("lat",pos.coords.latitude.toFixed(6));setText("lon",pos.coords.longitude.toFixed(6));setText("acc",Math.round(pos.coords.accuracy)+" m");setText("alt",pos.coords.altitude==null?"—":Math.round(pos.coords.altitude)+" m");setGPSStatus(T("active"));
 },()=>{setGPSStatus(T("denied"));watchId=null},{enableHighAccuracy:true,maximumAge:5000,timeout:15000});
}
function setGPSStatus(s){let x=document.getElementById("gpsstatus");if(x)x.textContent=s}
function setText(id,s){let x=document.getElementById(id);if(x)x.textContent=s}
function loadGPX(file){
 if(!file)return;
 const r=new FileReader();
 r.onload=()=>{try{const xml=new DOMParser().parseFromString(r.result,"application/xml");const pts=[...xml.getElementsByTagName("trkpt")].map(x=>({lat:+x.getAttribute("lat"),lon:+x.getAttribute("lon")})).filter(x=>Number.isFinite(x.lat)&&Number.isFinite(x.lon));if(!pts.length)throw 0;track=pts;try{indexedDB.open("alasummit",1).onupgradeneeded=e=>e.target.result.createObjectStore("gpx");indexedDB.open("alasummit",1).onsuccess=e=>{let db=e.target.result,tx=db.transaction("gpx","readwrite");tx.objectStore("gpx").put(r.result,"last");}}catch(e){}drawTrack();toast(T("loadOk"))}catch(e){toast(T("badGpx"))}};
 r.readAsText(file);
}
function drawTrack(){
 const path=document.getElementById("trackPath");if(!path)return;
 if(!track.length){path.setAttribute("d","");return}
 const minLat=Math.min(...track.map(x=>x.lat)),maxLat=Math.max(...track.map(x=>x.lat)),minLon=Math.min(...track.map(x=>x.lon)),maxLon=Math.max(...track.map(x=>x.lon)),pad=45;
 const sx=x=>pad+(x-minLon)/((maxLon-minLon)||1)*(800-pad*2),sy=y=>500-pad-(y-minLat)/((maxLat-minLat)||1)*(500-pad*2);
 path.setAttribute("d",track.map((p,i)=>(i?"L":"M")+sx(p.lon).toFixed(1)+" "+sy(p.lat).toFixed(1)).join(" "));
}
document.getElementById("back").onclick=()=>{document.getElementById("detail").classList.remove("active");document.getElementById("home").classList.remove("hidden");render();window.scrollTo({top:0,behavior:"smooth"})};
document.getElementById("langBtn").onclick=chooseLang;
document.getElementById("close").onclick=()=>document.getElementById("modal").classList.remove("open");
document.getElementById("modal").onclick=e=>{if(e.target.id==="modal")e.target.classList.remove("open")};
document.getElementById("gpsTop").onclick=()=>{if(!document.getElementById("detail").classList.contains("active"))openPeak(peaks[0].id);setTimeout(()=>{document.querySelector('[data-tab="gps"]')?.click()},80)};
document.getElementById("favTop").onclick=()=>{window.onlyFav=!window.onlyFav;render()};
document.getElementById("accountTop").onclick=profileModal;
document.getElementById("profileBtn").onclick=profileModal;
document.getElementById("partnersBtn").onclick=partnersModal;
document.getElementById("search").oninput=e=>{query=e.target.value;render()};
document.getElementById("clear").onclick=resetAll;
document.querySelectorAll(".chip").forEach(c=>c.onclick=()=>{filter=c.dataset.filter;document.querySelectorAll(".chip").forEach(x=>x.classList.toggle("active",x===c));render()});
document.addEventListener("click",e=>{if(e.target.id==="gpsStart")startGPS()});

if(!lang)chooseLang(); else applyLang();
</script>
</body>
</html>
